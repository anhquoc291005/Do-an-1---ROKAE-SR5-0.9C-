Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: world
    Background Color: 28; 34; 43
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid 100 mm
    Enabled: true
    Cell Size: 0.1
    Plane Cell Count: 20
  - Class: rviz_default_plugins/RobotModel
    Name: ROKAE SR5
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Durability Policy: Transient Local
    Visual Enabled: true
    Collision Enabled: false
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.9
      Focal Point:
        X: 0.3
        Y: 0.04
        Z: 0.41
      Pitch: 0.28
      Yaw: -0.82
Window Geometry:
  Width: 1080
  Height: 740
  X: 0
  Y: 0
